+/// MEASUREMENT BUILD ONLY. The shipped pass, and the cap on top of it when asked for.
+fn reconcile_evidence(criteria: &mut [EvidenceCriterion]) {
+    reconcile_evidence_shipped(criteria);
+    if alt("triple_cap") {
+        cap_missense_triple(criteria);
+    }
 }
 
