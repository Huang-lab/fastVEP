+/// MEASUREMENT BUILD ONLY. A combined cap of 4 points (Strong) on PP2, PM1 and PP3 when all three
+/// are met: the weakest of the three, PP2, is withheld when they would otherwise score more.
+fn cap_missense_triple(criteria: &mut [EvidenceCriterion]) {
+    let points = |c: &EvidenceCriterion| match c.strength {
+        EvidenceStrength::Supporting => 1,
+        EvidenceStrength::Moderate => 2,
+        EvidenceStrength::Strong => 4,
+        _ => 8,
+    };
+    let find = |criteria: &[EvidenceCriterion], base: &str| {
+        criteria
+            .iter()
+            .position(|c| c.met && (c.code == base || c.code.starts_with(&format!("{base}_"))))
+    };
+    let (Some(pp2), Some(pm1), Some(pp3)) = (
+        find(criteria, "PP2"),
+        find(criteria, "PM1"),
+        find(criteria, "PP3"),
+    ) else {
+        return;
+    };
+    if points(&criteria[pp2]) + points(&criteria[pm1]) + points(&criteria[pp3]) > 4 {
+        suppress(
+            &mut criteria[pp2],
+            "Suppressed: PP2, PM1 and PP3 together would exceed the Strong cap of 4 points.",
+        );
+    }
+}
