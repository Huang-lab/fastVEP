# External tools
ensembl-vep/
Nirvana/
echtvar-src/
echtvar/

# Build
target/
.DS_Store

# Conda build artifacts
conda/recipe/build/
conda-bld/

# Large data (downloaded via benchmarks/download_data.sh)
/test_data/

# Root test-fixture directory (small files are force-added via `git add -f`).
# MUST stay anchored with a leading slash: a bare `tests/` also matches
# crates/*/tests/, which silently kept integration tests out of the repo.
/tests/

# Benchmark data and output (scripts are tracked)
benchmarks/output/
benchmarks/*.fastvep.cache

# Auto-generated caches
*.fastvep.cache

# data
/genomes/

# docs
*stats.json
*docx
*pdf

# Generated by .github/workflows/pages.yml (`cp web/index.html docs/index.html`)
# at deploy time. web/index.html is the single source of truth.
docs/index.html

# Local benchmark data (downloaded sources, built .osa, intermediate VCFs)
/data/

# tabix index files cached during remote queries (placed in CWD by htslib)
*.tbi
*.csi

# Supplementary-annotation databases emitted by `sa-build` during test runs
*.osa
*.osa.idx
*.oga
*.osi

# log files from test runs
*.log
*.out
